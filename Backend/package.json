{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "pm2-runtime ecosystem.config.js",
    "dev": "nodemon index.js"
  },
  "nodemonConfig": {
    "watch": [
      "controllers",
      "models",
      "routes",
      "services",
      "workers",
      "middlewares",
      "config",
      "index.js"
    ],
    "ext": "js,json",
    "ignore": [
      "logs/**",
      ".logs/**",
      "uploads/**",
      "public/**",
      "*.log",
      "preservation-manifest.json",
      "node_modules/**"
    ],
    "delay": 1500
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "bullmq": "^5.66.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "minio": "^7.1.3",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  },
  "overrides": {
    "decode-uri-component": "^0.5.1",
    "fast-xml-parser": "^5.12.1"
  }
}
