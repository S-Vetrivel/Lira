# Lira Workspace Backend Environment Configuration
NODE_ENV=development
TZ=Asia/Kolkata
PORT=4000
MONGO_DB=mongodb://127.0.0.1:27017/sass

# Security & Session Secrets (change in production)
JWT_SECRET=replace_with_long_random_jwt_secret
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
AI_MASTER_KEY=

# Frontend / Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v3/auth/google/callback

# Unified Redis (BullMQ AI Queue & Socket.IO Adapter)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
AI_WORKER_CONCURRENCY=6

# Superadmin & Seeding
SUPERADMIN_EMAILS=admin@incuman.com
DEFAULT_SUPERADMIN_EMAIL=admin@incuman.com
DEFAULT_SUPERADMIN_PASSWORD=replace_with_initial_password

# MinIO Object Storage
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=icuman
MAX_TRANSFER_BANDWIDTH_KBPS=10240

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@incuman.com

# Default External AI Provider Keys (optional - can also configure encrypted Vault keys in /roles?tab=ai)
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SMTP Email Worker (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lira Workspace" <noreply@incuman.com>

